<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>AnyCPU</Platform>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
    <ServerPublishDirectory>\\ns-autodesk\c$\ADSK-Automation\CreditSafe</ServerPublishDirectory>
  </PropertyGroup>

  <Target Name="BuildReleaseForServerPublish" DependsOnTargets="ValidateProductionPublishTarget">
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Build"
      Properties="Configuration=Release;Platform=AnyCPU;PlatformTarget=x64"
      RemoveProperties="PublishProfile;ServerPublishDirectory" />
  </Target>

  <Target Name="ValidateProductionPublishTarget">
    <Error
      Condition="!Exists('$(ServerPublishDirectory)')"
      Text="The CreditSafe deployment folder '$(ServerPublishDirectory)' is unavailable. Confirm the server is online and the current Windows account can access the administrative share." />
  </Target>

  <Target Name="PublishToServer" DependsOnTargets="BuildReleaseForServerPublish;ValidateProductionPublishTarget">
    <PropertyGroup>
      <ServerBackupDirectory>$(ServerPublishDirectory)\Backup_$([System.DateTime]::Now.ToString('yyyyMMdd_HHmmss'))</ServerBackupDirectory>
    </PropertyGroup>

    <ItemGroup>
      <ExistingServerFiles Include="$(ServerPublishDirectory)\*.exe;$(ServerPublishDirectory)\*.dll;$(ServerPublishDirectory)\*.config" />
      <CreditSafePublishFiles Include="$(MSBuildProjectDirectory)\bin\Release\*.exe;$(MSBuildProjectDirectory)\bin\Release\*.dll;$(MSBuildProjectDirectory)\bin\Release\*.config" />
    </ItemGroup>

    <MakeDir Directories="$(ServerBackupDirectory)" Condition="'@(ExistingServerFiles)' != ''" />
    <Copy
      SourceFiles="@(ExistingServerFiles)"
      DestinationFiles="@(ExistingServerFiles->'$(ServerBackupDirectory)\%(Filename)%(Extension)')"
      SkipUnchangedFiles="false"
      Condition="'@(ExistingServerFiles)' != ''" />
    <Copy
      SourceFiles="@(CreditSafePublishFiles)"
      DestinationFiles="@(CreditSafePublishFiles->'$(ServerPublishDirectory)\%(Filename)%(Extension)')"
      SkipUnchangedFiles="true"
      Retries="3"
      RetryDelayMilliseconds="1000" />

    <Message
      Importance="high"
      Text="Published CreditSafeLogicController to $(ServerPublishDirectory). Previous deployment backed up to $(ServerBackupDirectory)." />
  </Target>

  <Target Name="Publish" DependsOnTargets="PublishToServer" />
</Project>
